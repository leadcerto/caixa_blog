# =============================================================================
#  .env.production.example — Imóveis da Caixa (Staging: temporario.imoveisdacaixa.com.br)
#  INSTRUÇÃO: Copie este arquivo para .env no servidor e preencha os campos marcados
#  com <<PREENCHER>>. NUNCA comite o .env real no repositório Git.
# =============================================================================

# ── Aplicação ─────────────────────────────────────────────────────────────────
APP_NAME="Imóveis da Caixa"
APP_ENV=production
APP_KEY=                          # Gerado automaticamente via: php artisan key:generate
APP_DEBUG=false
APP_URL=https://temporario.imoveisdacaixa.com.br
APP_TIMEZONE=America/Sao_Paulo
APP_LOCALE=pt_BR

# ── Dados Institucionais (usados em views e meta tags) ────────────────────────
APP_COMPANY_NAME="Imóveis da Caixa LTDA"
APP_COMPANY_EMAIL="sac@imoveisdacaixa.com.br"
APP_COMPANY_CNPJ="50.563.863/0001-45"
APP_COMPANY_CRECI="10.234/RJ"
APP_COMPANY_WHATSAPP="21997882950"

# ── Banco de Dados (MySQL — criar no hPanel antes de rodar migrate) ────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=<<PREENCHER: nome_do_banco_criado_no_hpanel>>
DB_USERNAME=<<PREENCHER: usuario_do_banco>>
DB_PASSWORD=<<PREENCHER: senha_do_banco>>

# ── Cache / Sessão / Fila (File = sem dependências extras em shared hosting) ──
CACHE_STORE=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log

# ── Logs ──────────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# ── Filesystem ────────────────────────────────────────────────────────────────
FILESYSTEM_DISK=public

# ── Mail (ajustar quando o módulo de e-mail for implementado) ─────────────────
MAIL_MAILER=smtp
MAIL_HOST=<<PREENCHER>>
MAIL_PORT=587
MAIL_USERNAME=<<PREENCHER>>
MAIL_PASSWORD=<<PREENCHER>>
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="sac@imoveisdacaixa.com.br"
MAIL_FROM_NAME="${APP_COMPANY_NAME}"

# ── Google Business Profile API (integração GMB — preencher quando ativo) ─────
GOOGLE_BUSINESS_CLIENT_ID=
GOOGLE_BUSINESS_CLIENT_SECRET=
GOOGLE_BUSINESS_REFRESH_TOKEN=
GOOGLE_BUSINESS_ACCOUNT_ID=
